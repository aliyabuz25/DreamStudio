<%- include('partials/header') %>

<div class="row">
  <div class="col-lg-3 col-6">
    <div class="small-box bg-info">
      <div class="inner">
        <h3><%= usersCount %></h3>
        <p>Kayıtlı Kullanıcı</p>
      </div>
      <div class="icon">
        <i class="fas fa-users"></i>
      </div>
    </div>
  </div>
</div>

<div class="row mt-4">
  <div class="col-12">
    <div class="card">
      <div class="card-header border-0">
        <h3 class="card-title">Son Kayıt Olanlar</h3>
      </div>
      <div class="card-body table-responsive p-0">
        <table class="table table-striped table-valign-middle">
          <thead>
          <tr>
            <th>İsim</th>
            <th>E-Posta</th>
            <th>User No (DW-ID)</th>
            <th>Bakiye</th>
          </tr>
          </thead>
          <tbody>
          <% users.forEach(u => { %>
          <tr>
            <td><%= u.name %> <%- u.role==='admin' ? '<span class="badge badge-danger">Admin</span>' : '' %></td>
            <td><%= u.email %></td>
            <td><strong>DW-<%= u.userNo %></strong></td>
            <td><span class="text-success"><i class="fas fa-lira-sign"></i> <%= u.credits %></span></td>
          </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>