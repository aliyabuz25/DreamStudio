<script>
function toggleSidebar() {
  document.getElementById('sidebar').classList.toggle('show');
  document.getElementById('sidebarOverlay').classList.toggle('show');
}

$(function(){
  fetch('/api/badge').then(r=>r.json()).then(d=>{
    if(d.count>0) document.getElementById('badgeOrders').textContent=d.count;
    else document.getElementById('badgeOrders').style.display='none';
  }).catch(()=>{});
});
</script>
