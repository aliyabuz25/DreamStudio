let currentLanguage = 'tr';

function translatePage(lang) {
  const elements = document.querySelectorAll('[data-i18n]');
  elements.forEach(el => {
    const key = el.getAttribute('data-i18n');
    if(translations[lang][key]) el.textContent = translations[lang][key];
  });
}

function setLang(code, flagCode) {
  currentLanguage = code;
  document.getElementById('flag-icon').src = `https://hatscripts.github.io/circle-flags/flags/${flagCode}.svg`;
  document.querySelectorAll('.lang-item').forEach(el => el.classList.remove('selected', 'font-bold'));
  event.currentTarget.classList.add('selected', 'font-bold');
  document.getElementById('lang-menu').classList.remove('show');
  translatePage(code);
}

function toggleLang() {
  document.getElementById('lang-menu').classList.toggle('show');
}
document.addEventListener('click', (e) => {
  const m = document.getElementById('lang-menu');
  if (m.classList.contains('show') && !e.target.closest('.lang-bubble')) {
    m.classList.remove('show');
  }
});

function showToast(msg) {
  const container = document.getElementById('toast-container');
  const toast = document.createElement('div');
  toast.className = 'custom-toast';
  toast.innerText = msg;
  container.appendChild(toast);
  setTimeout(() => {
    toast.style.opacity = '0';
    toast.style.transform = 'translateY(-20px)';
    setTimeout(() => toast.remove(), 300);
  }, 2000);
}

function copyText(text) {
  navigator.clipboard.writeText(text).then(() => showToast(translations[currentLanguage].copied || 'Kopyalandı'));
}

// TAB SWITCHER
function switchTab(tabId) {
  // Check KVKK for Wallet
  if (tabId === 'wallet') {
    if (!localStorage.getItem('dw_kvkk_accepted')) {
      document.getElementById('kvkk-overlay').classList.add('show');
      document.getElementById('kvkk-sheet').classList.add('open');
      return; // Stop switching
    }
  }

  document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
  document.getElementById('tab-' + tabId).classList.add('active');
  
  document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
  event.currentTarget.classList.add('active');
  
  // Yalnızca ana sayfa kapsayıcısının dikey (vertical) scroll'unu yavaşça başa al, 
  // yatay slider (h-slider vb.) öğelerine müdahale etme.
  const mainScroll = document.getElementById('main-scroll');
  if (mainScroll) {
    mainScroll.scrollTo({ top: 0, left: 0, behavior: 'auto' });
  }
}

// KVKK Logic
function acceptKvkk() {
  localStorage.setItem('dw_kvkk_accepted', 'true');
  document.getElementById('kvkk-overlay').classList.remove('show');
  document.getElementById('kvkk-sheet').classList.remove('open');
  // Auto switch to wallet after accept
  document.querySelector('.tab-btn:nth-child(4)').click();
}

// INIT
document.addEventListener('DOMContentLoaded', () => {
  const waitlist = localStorage.getItem('dw_waitlist');
  if (waitlist) {
    const data = JSON.parse(waitlist);
    const orderStat = document.getElementById('stat-orders');
    if(orderStat) orderStat.textContent = '1';
    
    document.getElementById('no-order-container').classList.add('hidden');
    document.getElementById('waitlist-container').classList.remove('hidden');
    
    let delText = 'GelAl Noktası';
    if(data.deliveryType === 'kargo') delText = 'Adrese Kargo';
    if(data.deliveryType === 'montaj') delText = 'Stüdyoda Montaj';
    document.getElementById('saved-delivery-type').textContent = delText;
  }

  // Session Check
  <% if (Object.keys(session.images || {}).length > 0 && !session.completed) { %>
    document.querySelector('.tab-btn:nth-child(2)').click(); // Go to Design Tab
  <% } %>
});

function cancelOrder() {
  localStorage.removeItem('dw_waitlist');
  window.location.reload();
}

// UPLOAD & ANALYSIS
const bakiye = <%= credits %>;

function triggerUpload(posKey) { document.getElementById('file-' + posKey).click(); }
function handleUpload(posKey, input) {
  if (!input.files || !input.files[0]) return;
  const formData = new FormData();
  formData.append('image', input.files[0]);

  fetch('/analyze/upload/' + posKey, { method: 'POST', body: formData })
  .then(r => r.json()).then(data => {
    if (data.success) window.location.reload();
  });
}

function resetDesign() {
  fetch('/analyze/reset', { headers: { 'Accept': 'application/json' } }).then(() => {
    window.location.reload();
  });
}

function confirmOrder() {
  document.getElementById('loading-overlay').classList.remove('hidden');
  document.getElementById('loading-overlay').classList.add('flex');
  {
    
    fetch('/analyze/run', { method: 'POST', headers: { 'Content-Type': 'application/json' } })
    .then(r => r.json())
    .then(data => {
      document.getElementById('loading-overlay').classList.add('hidden');
      document.getElementById('loading-overlay').classList.remove('flex');
      
      if (data.success) {
        document.getElementById('result-overlay').classList.add('show');
        document.getElementById('result-sheet').classList.add('open');
        document.getElementById('ai-brand-model').textContent = `${data.result.marka || '-'} ${data.result.model || ''}`;
      } else {
        showToast(data.error || 'Analiz başarısız');
      }
    })
    .catch(err => {
      document.getElementById('loading-overlay').classList.add('hidden');
      document.getElementById('loading-overlay').classList.remove('flex');
      showToast('Bağlantı hatası: ' + err.message);
    });
  }
}

// Result Sheet Selection
let selectedDelivery = 'gelal';
function selectDelivery(type) {
  selectedDelivery = type;
  
  // Reset all
  const opts = ['gelal', 'kargo', 'montaj'];
  opts.forEach(o => {
    const el = document.getElementById('opt-' + o);
    el.classList.remove('ring-2', 'ring-black');
    el.querySelector('.check-icon').className = 'bi bi-circle text-gray-300 text-xl check-icon';
  });

  // Select target
  const target = document.getElementById('opt-' + type);
  target.classList.add('ring-2', 'ring-black');
  target.querySelector('.check-icon').className = 'bi bi-check-circle-fill text-black text-xl check-icon';
}

function completeOrder() {
  localStorage.setItem('dw_waitlist', JSON.stringify({
    date: new Date().toISOString(),
    deliveryType: selectedDelivery,
    status: 'waiting'
  }));
  // Sonuç sheet'ini kapat
  document.getElementById('result-overlay').classList.remove('show');
  document.getElementById('result-sheet').classList.remove('open');
  // Siparişler sekmesine geç
  document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
  document.getElementById('tab-orders').classList.add('active');
  document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
  document.querySelector('.tab-btn:nth-child(3)').classList.add('active');
  // Sipariş durumunu güncelle
  document.getElementById('no-order-container').classList.add('hidden');
  document.getElementById('waitlist-container').classList.remove('hidden');
  let delText = 'GelAl Noktası';
  if(selectedDelivery === 'kargo') delText = 'Adrese Kargo';
  if(selectedDelivery === 'montaj') delText = 'Stüdyoda Montaj';
  document.getElementById('saved-delivery-type').textContent = delText;
  showToast('Siparişiniz alındı. En kısa sürede size geri dönüş yapacağız.');
}
</script>

